		{"id":"step3","type":"text","text":"**3. Finanzas → Timbrado**\nPOST TimbrarFactura","x":300,"y":390,"width":280,"height":70},
		{"id":"step4","type":"text","text":"**4. Timbrado → BD Timbrado**\nGuardar TimbradoLog: IdPeticion, JSONPeticion, Catálogo Tipo de Petición (Factura, Nota de Crédito o Complemento de Pago), Fecha de Registro, Fecha Última Actualización, UserName, ClienteName (ProquifaDotNet, Finanzas, MailBot), IsActive, IdStatus (entra como Pending)","x":720,"y":500,"width":340,"height":190},
		{"id":"step5","type":"text","text":"**5. BD Timbrado → Timbrado**\nRegresa (GUID)","x":750,"y":730,"width":280,"height":70},
