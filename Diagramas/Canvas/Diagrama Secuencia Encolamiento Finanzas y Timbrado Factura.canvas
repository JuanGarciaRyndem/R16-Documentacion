	"nodes":[
		{"id":"hdr-workerfinanzas","type":"text","text":"**Worker.Finanzas**\nFactura por Adelantado o Factura","x":0,"y":0,"width":280,"height":70,"color":"6"},
		{"id":"hdr-bdpqf2","type":"text","text":"**BD PQF2**","x":300,"y":0,"width":280,"height":70,"color":"5"},
		{"id":"hdr-timbrado","type":"text","text":"**Timbrado**","x":600,"y":0,"width":280,"height":70,"color":"4"},
		{"id":"hdr-bdtimbrado","type":"text","text":"**BD Timbrado**","x":900,"y":0,"width":280,"height":70,"color":"5"},
		{"id":"hdr-pac","type":"text","text":"**PAC Legacy**","x":1200,"y":0,"width":280,"height":70,"color":"6"},
		{"id":"step1","type":"text","text":"**1. Worker.Finanzas → BD PQF2**\nObtiene Pendiente de la tabla ColaEventosFinanzas (Ejemplo)","x":150,"y":150,"width":280,"height":90},
		{"id":"step2","type":"text","text":"**2. BD PQF2 → Worker.Finanzas**\nRegresa el ID Factura","x":150,"y":280,"width":280,"height":70},
		{"id":"step3","type":"text","text":"**3. Worker.Finanzas → BD PQF2**\nObtiene los detalles de la factura","x":150,"y":390,"width":280,"height":70},
		{"id":"step4","type":"text","text":"**4. BD PQF2 → Worker.Finanzas**\nRegresa detalles de la factura","x":150,"y":500,"width":280,"height":70},
		{"id":"step5","type":"text","text":"**5. Worker.Finanzas → Timbrado**\nPOST TimbrarFactura","x":300,"y":610,"width":280,"height":70},
		{"id":"step6","type":"text","text":"**6. Timbrado → BD Timbrado**\nGuardar TimbradoLog: IdPeticion, JSONPeticion, Catálogo Tipo de Petición (Factura, Nota de Crédito o Complemento de Pago), Fecha de Registro, Fecha Última Actualización, UserName, ClienteName (ProquifaDotNet, Finanzas, MailBot), IsActive, IdStatus (entra como Pending)","x":720,"y":720,"width":340,"height":190},
		{"id":"step7","type":"text","text":"**7. BD Timbrado → Timbrado**\nRegresa (GUID)","x":750,"y":940,"width":280,"height":70},
		{"id":"step8","type":"text","text":"**8. Timbrado → PAC Legacy**\nMétodo PAC para timbrar","x":900,"y":1050,"width":280,"height":70},
		{"id":"step9","type":"text","text":"**9. PAC Legacy → Timbrado**\nRespuesta de PAC","x":900,"y":1160,"width":280,"height":70},
		{"id":"step10","type":"text","text":"**10. Timbrado → Worker.Finanzas**\nRegresa (Objeto CFDI + XML)","x":300,"y":1270,"width":280,"height":70},
		{"id":"step11","type":"text","text":"**11. Timbrado → BD Timbrado**\nGuardar TimbradoLog: IdPeticion (GUID), Fecha de Timbrado, IdStatus (se actualiza a Generado o Timbrado), Respuesta, XML","x":720,"y":1380,"width":340,"height":190},
		{"id":"step12","type":"text","text":"**12. BD Timbrado → Timbrado**\nConfirmación de actualización","x":750,"y":1600,"width":280,"height":70},
		{"id":"step13","type":"text","text":"**13. [Si hay errores] Worker.Finanzas → BD PQF2**\nSe queda como pendiente y se incrementa el número de reintentos. Si el número de reintentos es igual o supera el límite, se envía correo a soporte indicando que no se pudo timbrar","x":150,"y":1710,"width":280,"height":130,"color":"1"},
		{"id":"step14","type":"text","text":"**14. BD PQF2 → Worker.Finanzas**\nConfirmación","x":150,"y":1870,"width":280,"height":70,"color":"1"},
		{"id":"step15","type":"text","text":"**15. [Si no hay errores] Worker.Finanzas → BD PQF2**\nSe vincula el CFDI a fccFactura. Se genera el PDF de la factura y se sube a Minio. Se sube el XML a Minio. Se vincula el XML y el PDF a fccFactura","x":150,"y":1980,"width":280,"height":130,"color":"4"},
		{"id":"step16","type":"text","text":"**16. BD PQF2 → Worker.Finanzas**\nConfirmación","x":150,"y":2140,"width":280,"height":70,"color":"4"}
	],
