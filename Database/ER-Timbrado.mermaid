---
title: Timbrado — ProquifaDotNetTimbrado (AppSetting + StampingLog; EmpresaFolio movida a Finanzas 07/07/2026)
---
erDiagram
    AppSetting {
        uniqueidentifier Id PK
        varchar Name
        varchar Value
        varchar Description
        datetime2 CreatedAt
        datetime2 UpdatedAt
        bit IsActive
    }
    StampingLog {
        uniqueidentifier Id PK
        uniqueidentifier CfdiGeneradaId "referencia informativa cross-database (sin FK)"
        varchar Action "Stamp | Cancel"
        varchar PreviousStatus
        varchar NewStatus "Pending | Stamped | Failed"
        varchar Request "payload enviado al PAC"
        varchar Response "respuesta del PAC"
        varchar ErrorMessage
        int DurationMs
        datetime2 CreatedAt
        bit IsActive
    }
